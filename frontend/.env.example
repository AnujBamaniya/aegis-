# Aegis Matrix — copy to .env.local. Never commit real values.

# Data source switch: "mock" (default, synthetic fixtures) | "live" (proxied API).
NEXT_PUBLIC_DATA_MODE=mock

# Server-side only (used by src/app/api/aegis/[...path]/route.ts proxy).
# Not exposed to the browser; the browser only ever calls /api/aegis/*.
AEGIS_API_URL=http://127.0.0.1:8000
